<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Messages | Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #0f172a; color: #fff; }
        .table-custom { background-color: #1e293b; color: #fff; border-radius: 8px; overflow: hidden; }
        .table-custom th { background-color: #334155; color: #38bdf8; }
        .table-custom td { color: #cbd5e1; vertical-align: middle; }
    </style>
</head>
<body class="py-5">

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-envelope-open text-info me-2"></i>Contact Messages</h2>
        <a href="/dashboard" class="btn btn-outline-light rounded-pill"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
    </div>

    <% if (messages && messages.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% messages.forEach(msg => { %>
                        <tr>
                            <td><%= new Date(msg.created_at || Date.now()).toLocaleDateString() %></td>
                            <td><strong><%= msg.name %></strong></td>
                            <td><a href="mailto:<%= msg.email %>" class="text-info"><%= msg.email %></a></td>
                            <td><span class="badge bg-secondary"><%= msg.subject %></span></td>
                            
                            <!-- 🟢 हा तो नवीन 'View & Pop-up' वाला भाग आहे -->
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 180px;">
                                    <%= msg.message %>
                                </span>
                                <br>
                                <button class="btn btn-sm btn-link text-info p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#msgModal<%= msg.id %>">
                                    <i class="bi bi-eye"></i> View Full Message
                                </button>

                                <!-- Modal Pop-up -->
                                <div class="modal fade text-dark" id="msgModal<%= msg.id %>" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Message from <%= msg.name %></h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body text-start">
                                                <p class="mb-1"><strong>Email:</strong> <%= msg.email %></p>
                                                <p class="mb-2"><strong>Subject:</strong> <%= msg.subject %></p>
                                                <hr>
                                                <p class="mb-1"><strong>Message:</strong></p>
                                                <div class="p-3 bg-light rounded text-wrap" style="white-space: pre-line;"><%= msg.message %></div>
                                            </div>
                                            <div class="modal-footer">
                                                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=<%= msg.email %>&su=Re: <%= msg.subject %>" target="_blank" class="btn btn-primary btn-sm">
                                                    <i class="bi bi-envelope"></i> Reply via Gmail
                                                </a>
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <a href="https://mail.google.com/mail/?view=cm&fs=1&to=<%= msg.email %>&su=Re: <%= msg.subject %>" target="_blank" class="btn btn-info btn-sm text-white">
                                    <i class="bi bi-reply-fill"></i> Reply
                                </a>
                                <a href="/delete-contact/<%= msg.id %>" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this message?')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="alert alert-secondary text-center py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No messages received yet.
        </div>
    <% } %>
</div>

<!-- Bootstrap JS Link Modal चालण्यासाठी आवश्यक आहे -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>