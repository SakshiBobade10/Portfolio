<%- include("partials/header", { title: "Projects" }) %>
<%- include("partials/navbar") %>

<!-- CSS Custom Styling for Image Design -->
<style>
  body {
    background-color: #030712 !important;
  }

  .project-card-custom {
    background-color: #070d19 !important;
    border: 1px solid rgba(0, 150, 255, 0.2) !important;
    border-radius: 16px !important;
    transition: all 0.3s ease-in-out;
  }

  .project-card-custom:hover {
    border-color: rgba(0, 180, 255, 0.5) !important;
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 140, 255, 0.15);
  }

  /* Top Category Pill/Badge Style */
  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 50px;
    border: 1px solid rgba(0, 212, 255, 0.4);
    background: rgba(0, 150, 255, 0.08);
    color: #00d4ff;
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* Technology Badges Style */
  .tech-badge {
    background: transparent;
    border: 1px solid rgba(0, 150, 255, 0.3);
    color: #00b0ff;
    border-radius: 50px;
    padding: 5px 14px;
    font-size: 0.78rem;
    font-weight: 500;
  }

  /* Full Width Pill Buttons Style */
  .btn-code-pill {
    width: 100%;
    border-radius: 50px;
    border: 1px solid rgba(0, 150, 255, 0.4);
    background: transparent;
    color: #00b0ff;
    padding: 8px 0;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .btn-code-pill:hover {
    background: rgba(0, 150, 255, 0.15);
    color: #ffffff;
    border-color: #00b0ff;
  }
</style>

<!-- Main Container -->
<div class="container text-white" style="padding-top: 120px; padding-bottom: 80px;">
  
  <!-- Page Header Title -->
  <div class="text-center mb-5">
    <h1 class="fw-bold display-4 mb-2" style="color: #2b7fff; font-weight: 800;">
      My Projects
    </h1>
    <p class="text-secondary lead fs-6">Showcasing my technical journey, core builds, and practical implementations.</p>
  </div>

  <!-- Projects Grid (Side-by-Side Cards) -->
  <div class="row g-4">
    <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
      <% projects.forEach(function(p) { %>
        
        <div class="col-lg-6 col-12">
          <div class="card h-100 p-4 project-card-custom d-flex flex-column justify-content-between">
            
            <div>
              <!-- Top Left Category Pill -->
              <div class="mb-3">
                <span class="category-pill">
                  <% if (p.category && (p.category.toLowerCase().includes('sql') || p.category.toLowerCase().includes('database'))) { %>
                    <i class="bi bi-database"></i>
                  <% } else if (p.category && p.category.toLowerCase().includes('excel')) { %>
                    <i class="bi bi-file-earmark-excel"></i>
                  <% } else { %>
                    <i class="bi bi-code-slash"></i>
                  <% } %>
                  <%= p.category ? p.category : 'Project' %>
                </span>
              </div>

              <!-- Project Title -->
              <h3 class="fw-bold text-white mb-3" style="font-size: 1.4rem;">
                <%= p.title %>
              </h3>

              <!-- Project Description -->
              <p class="text-secondary mb-4" style="font-size: 0.92rem; line-height: 1.6; color: #94a3b8 !important;">
                <%= p.description %>
              </p>

              <!-- Tech Stack Badges -->
              <% if (p.technology) { %>
                <div class="d-flex flex-wrap gap-2 mb-4">
                  <% p.technology.split(',').forEach(function(tech) { %>
                    <span class="tech-badge">
                      <%= tech.trim() %>
                    </span>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <!-- Action Buttons (Code / Demo) -->
            <div class="pt-2">
              <div class="row g-2">
                <% if (p.github_link && p.github_link.trim() !== '') { %>
                  <div class="<%= (p.demo_link && p.demo_link.trim() !== '') ? 'col-6' : 'col-12' %>">
                    <a href="<%= p.github_link %>" target="_blank" class="btn-code-pill">
                      <i class="bi bi-github"></i> Code
                    </a>
                  </div>
                <% } %>

                <% if (p.demo_link && p.demo_link.trim() !== '') { %>
                  <div class="<%= (p.github_link && p.github_link.trim() !== '') ? 'col-6' : 'col-12' %>">
                    <a href="<%= p.demo_link %>" target="_blank" class="btn-code-pill" style="background: rgba(0, 150, 255, 0.2); border-color: #00b0ff; color: #fff;">
                      <i class="bi bi-box-arrow-up-right"></i> Live Demo
                    </a>
                  </div>
                <% } %>
              </div>
            </div>

          </div>
        </div>

      <% }); %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <p class="text-muted fs-5">No projects found. Add projects from your Admin Dashboard!</p>
      </div>
    <% } %>
  </div>

</div>

<%- include("partials/footer") %>