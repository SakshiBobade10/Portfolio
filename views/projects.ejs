<%- include("partials/header", { title: "Projects" }) %>
<%- include("partials/navbar") %>

<!-- Hover/Popup Effect  CSS -->
<style>
  .project-card-interactive {
    transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    cursor: pointer;
  }
  .project-card-interactive:hover {
    transform: translateY(-8px) scale(1.02) !important;
    background-color: #121c33 !important;
    border-color: rgba(0, 136, 255, 0.4) !important;
    box-shadow: 0 12px 30px rgba(0, 136, 255, 0.2) !important;
  }
  
  /*  CSS */
  .row.g-4 {
    display: flex;
    flex-wrap: wrap;
  }
</style>

<!-- Header Section -->
<div class="container text-white" style="padding-top: 130px; padding-bottom: 80px;">
  
  <!-- Title with Matching Internship Style -->
  <div class="text-center mb-5" data-aos="fade-down">
    <h1 class="fw-bold display-4 mb-2" style="color: #3882f6 !important; font-weight: 700;">
      My Projects
    </h1>
    <p class="text-secondary lead fs-6">Showcasing my technical journey, core builds, and practical implementations.</p>
  </div>

  <% 
    let groupedProjects = {};
    if (typeof projects !== 'undefined' && projects.length > 0) {
      projects.forEach(function(p) {
        let cat = p.category ? p.category.trim() : 'Other Projects';
        if (!groupedProjects[cat]) {
          groupedProjects[cat] = [];
        }
        groupedProjects[cat].push(p);
      });
    }
  %>

  <% if (Object.keys(groupedProjects).length > 0) { %>
    <% Object.keys(groupedProjects).forEach(function(category) { %>
      
      <!-- Domain / Category Heading -->
      <div class="mb-4 mt-4" data-aos="fade-right">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background: rgba(0, 212, 255, 0.08); border: 1px solid rgba(0, 212, 255, 0.25);">
          <i class="bi bi-folder2-open fs-4" style="color: #00d4ff !important;"></i>
          <h3 class="fw-bold mb-0 fs-4" style="color: #00d4ff !important; letter-spacing: 0.5px;">
            <%= category %>
          </h3>
        </div>
      </div>

      <!-- Project Cards Grid with Hover Animation -->
      <div class="row g-4 mb-5">
        <% groupedProjects[category].forEach(function(p, index) { %>
         <div class="col-lg-6 col-12 mb-4" data-aos="fade-up" data-aos-delay="<%= index * 100 %>"></div>
            
            <div class="card h-100 p-4 rounded-4 shadow-lg d-flex flex-column justify-content-between project-card-interactive" style="background-color: #0d1424 !important; border: 1px solid rgba(255, 255, 255, 0.08) !important;">
              
              <div>
                <h4 class="fw-bold text-white mb-2" style="font-size: 1.3rem;"><%= p.title %></h4>
                
                <p class="text-secondary small mb-3" style="font-size: 0.92rem; line-height: 1.6; color: #a0aec0 !important;">
                  <%= p.description %>
                </p>

                <% if (p.technology) { %>
                  <div class="d-flex flex-wrap gap-2 mb-3">
                    <% p.technology.split(',').forEach(function(tech) { %>
                      <span class="badge px-3 py-2 rounded-pill" style="background-color: rgba(0, 136, 255, 0.15); color: #00aaff; border: 1px solid rgba(0, 136, 255, 0.3); font-weight: 500; font-size: 11px;">
                        <%= tech.trim() %>
                      </span>
                    <% }); %>
                  </div>
                <% } %>
              </div>

              <!-- Action Buttons -->
              <% if ((p.github_link && p.github_link.trim() !== '') || (p.demo_link && p.demo_link.trim() !== '')) { %>
                <div class="d-flex gap-2 pt-3 border-top border-secondary border-opacity-25 mt-2">
                  <% if (p.github_link && p.github_link.trim() !== '') { %>
                    <a href="<%= p.github_link %>" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-3 flex-grow-1" style="border-color: #0088ff; color: #0088ff;">
                      <i class="bi bi-github me-1"></i> Code
                    </a>
                  <% } %>

                  <% if (p.demo_link && p.demo_link.trim() !== '') { %>
                    <a href="<%= p.demo_link %>" target="_blank" class="btn btn-sm rounded-pill px-3 flex-grow-1 fw-bold" style="background-color: #0088ff; color: #fff;">
                      <i class="bi bi-box-arrow-up-right me-1"></i> Live Demo
                    </a>
                  <% } %>
                </div>
              <% } %>

            </div>
          </div>
        <% }); %>
      </div>

    <% }); %>
  <% } else { %>
    <div class="text-center py-5" data-aos="fade-up">
      <p class="text-muted fs-5">No projects found. Add projects from your Admin Dashboard!</p>
    </div>
  <% } %>

</div>

<%- include("partials/footer") %>