<%- include("partials/header", { title: "Edit Project" }) %>

<div class="container mt-5 mb-5" style="max-width: 600px;">
  <div class="card bg-dark text-white border-secondary p-4 shadow-lg rounded-4">
    <h3 class="fw-bold mb-4 text-warning"><i class="bi bi-pencil-square me-2"></i> Edit Project</h3>
    
    <form action="/edit-project/<%= project.id %>" method="POST">
      
      <!-- Domain / Category -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Project Domain / Category</label>
        <input type="text" name="category" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" value="<%= project.category %>" required>
      </div>

      <!-- Project Title -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Project Title</label>
        <input type="text" name="title" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" value="<%= project.title %>" required>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Project Description</label>
        <textarea name="description" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" rows="3" required><%= project.description %></textarea>
      </div>

      <!-- NEW: Technology Input Box -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Technologies Used (comma separated)</label>
        <input type="text" name="technology" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" value="<%= project.technology || '' %>" placeholder="e.g. Node.js, Express, MySQL">
      </div>

      <!-- GitHub Link -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Project Link / GitHub Link</label>
        <input type="url" name="github_link" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" value="<%= project.github_link || '' %>" placeholder="https://github.com/...">
      </div>

      <!-- Demo Link -->
      <div class="mb-4">
        <label class="form-label text-secondary small fw-bold">Demo Link (Optional)</label>
        <input type="url" name="demo_link" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" value="<%= project.demo_link || '' %>" placeholder="https://...">
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning w-100 fw-bold py-2 rounded-pill text-dark">Update Project</button>
        <a href="/dashboard" class="btn btn-outline-light w-100 fw-bold py-2 rounded-pill">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include("partials/footer") %>