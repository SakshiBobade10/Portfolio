<%- include("partials/header", { title: "Add Skill" }) %>

<div class="container py-5 text-white">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card bg-dark text-white border-secondary p-4 shadow">
        <h3 class="fw-bold mb-4 text-primary">Add New Skill</h3>

        <form action="/add-skill" method="POST">
          <!-- 1. Skill Name Input -->
          <div class="mb-3">
            <label class="form-label text-secondary">Skill Name</label>
            <input type="text" name="skill_name" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Python, SQL, React" required>
          </div>

          <!-- 2. Skill Category Dropdown  -->
          <div class="mb-3">
            <label class="form-label text-secondary">Skill Category</label>
            <select name="category" class="form-select bg-dark text-white border-secondary" required>
              <option value="" disabled selected>Select Category</option>
              <option value="Data Analytics">Data Analytics</option>
              <option value="Programming">Programming</option>
              <option value="Web Development">Web Development</option>
              <option value="Databases & Tools">Databases & Tools</option>
            </select>
          </div>

          <!-- Proficiency Dropdown -->
<div class="mb-4">
  <label class="form-label text-secondary">Proficiency Level</label>
  <select name="proficiency" class="form-select bg-dark text-white border-secondary" required>
    <option value="" disabled selected>Select Level</option>
    <option value="Beginner">Beginner</option>
    <option value="Intermediate">Intermediate</option>
    <option value="Advanced">Advanced</option>
  </select>
</div>

          <button type="submit" class="btn btn-primary w-100 fw-bold">Add Skill</button>
          <a href="/dashboard" class="btn btn-outline-secondary w-100 mt-2">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>