<%- include("partials/header", { title: "Skills" }) %>
<%- include("partials/navbar") %>

<div class="container py-5 my-5">

    <div class="text-center mb-5" data-aos="fade-down">
        <h1 class="fw-bold text-gradient display-5">
            Technical Skills
        </h1>
        <p class="text-white lead">
            Technologies, programming languages and analytics tools I work with.
        </p>
    </div>

    <div class="row g-4">

        <!-- 1. Data Analytics -->
        <div class="col-md-6 col-lg-3" data-aos="fade-up">
            <div class="glass-card p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <i class="ri-bar-chart-box-line fs-1 text-success me-3"></i>
                    <h3 class="fs-5 text-white mb-0">
                        Data Analytics
                    </h3>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <% if (skills && skills.length > 0) { %>
                        <% skills.filter(s => s.category === 'Data Analytics').forEach(s => { %>
                            <span class="tech-badge"><%= s.skill_name %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- 2. Programming Languages -->
        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="100">
            <div class="glass-card p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <i class="ri-code-s-slash-line fs-1 text-primary me-3"></i>
                    <h3 class="fs-5 text-white mb-0">
                        Programming
                    </h3>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <% if (skills && skills.length > 0) { %>
                        <% skills.filter(s => s.category === 'Programming').forEach(s => { %>
                            <span class="tech-badge"><%= s.skill_name %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- 3. Web Development -->
        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="200">
            <div class="glass-card p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <i class="ri-layout-4-line fs-1 text-info me-3"></i>
                    <h3 class="fs-5 text-white mb-0">
                        Web Development
                    </h3>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <% if (skills && skills.length > 0) { %>
                        <% skills.filter(s => s.category === 'Web Development').forEach(s => { %>
                            <span class="tech-badge"><%= s.skill_name %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- 4. Databases & Tools -->
        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="300">
            <div class="glass-card p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <i class="ri-database-2-line fs-1 text-warning me-3"></i>
                    <h3 class="fs-5 text-white mb-0">
                        Databases & Tools
                    </h3>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <% if (skills && skills.length > 0) { %>
                        <% skills.filter(s => s.category === 'Databases & Tools').forEach(s => { %>
                            <span class="tech-badge"><%= s.skill_name %></span>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

    </div>

</div>

<%- include("partials/footer") %>