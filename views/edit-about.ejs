<%- include("partials/header", { title: "Edit About Page" }) %>

<div class="container py-5" style="max-width: 700px;">
  <div class="card bg-dark text-white border-secondary shadow-lg rounded-4 p-4">
    <h3 class="fw-bold mb-4 text-info">
      <i class="bi bi-person-vcard me-2"></i>Edit About Page Info
    </h3>
    
    <form action="/edit-about" method="POST">
      
      <!-- LOCATION -->
      <div class="mb-3">
        <label for="location" class="form-label text-light">Location</label>
        <input type="text" class="form-control bg-secondary bg-opacity-25 text-white border-secondary" id="location" name="location" value="<%= about.location || '' %>" placeholder="e.g. Pune, India" required>
      </div>

      <!-- EDUCATION -->
      <div class="mb-3">
        <label for="education" class="form-label text-light">Education / Degree</label>
        <input type="text" class="form-control bg-secondary bg-opacity-25 text-white border-secondary" id="education" name="education" value="<%= about.education || '' %>" placeholder="e.g. Bachelor of Computer Science">
      </div>

      <!-- ABOUT BIO -->
      <div class="mb-4">
        <label for="about_bio" class="form-label text-light">Detailed Bio / Summary</label>
        <textarea class="form-control bg-secondary bg-opacity-25 text-white border-secondary" id="about_bio" name="about_bio" rows="6" placeholder="Write detailed description for about page..."><%= about.about_bio || '' %></textarea>
      </div>

      <div class="d-flex justify-content-between">
        <a href="/dashboard" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
        <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-bold">Save About Info</button>
      </div>
    </form>
  </div>
</div>

<%- include("partials/footer") %>