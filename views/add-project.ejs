<%- include("partials/header", { title: "Add Project" }) %>

<div class="container mt-5 mb-5" style="max-width: 600px;">
  <div class="card bg-dark text-white border-secondary p-4 shadow-lg rounded-4">
    <h3 class="fw-bold mb-4 text-info"><i class="bi bi-folder-plus me-2"></i> Add New Project</h3>
    
    <form action="/add-project" method="POST">
      
      <!-- 1. Category -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Project Domain / Category</label>
        <input type="text" name="category" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="e.g. Full-Stack Web Development" required>
      </div>

      <!-- 2. Title -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Project Title</label>
        <input type="text" name="title" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="e.g. Portfolio Website" required>
      </div>

      <!-- 3. Description -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Project Description</label>
        <textarea name="description" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" rows="3" placeholder="Write a short description..." required></textarea>
      </div>

      <!-- 4. Technology -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Technologies Used</label>
        <input type="text" name="technology" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="e.g. Node.js, Express.js, EJS, MySQL" required>
      </div>

      <!-- 5. GitHub Link -->
      <div class="mb-3">
        <label class="form-label text-secondary small fw-bold">Project Link / GitHub Link</label>
        <input type="url" name="github_link" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="https://github.com/your-username/project">
      </div>

      <!-- 6. Demo Link (Optional) -->
      <div class="mb-4">
        <label class="form-label text-secondary small fw-bold">Demo Link (Optional)</label>
        <input type="url" name="demo_link" class="form-control bg-secondary bg-opacity-10 text-white border-secondary" placeholder="https://...">
      </div>

      <button type="submit" class="btn btn-info w-100 fw-bold py-2 rounded-pill">Add Project</button>
    </form>
  </div>
</div>

<%- include("partials/footer") %>