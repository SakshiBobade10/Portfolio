<%- include("partials/header", { title: "Home" }) %>
<%- include("partials/navbar") %>

<!-- 1. Hero Section -->
<section class="hero-section d-flex align-items-center min-vh-100 py-5">
  <div class="container">
    <div class="row align-items-center g-5">
      
      <!-- Left Profile Image -->
      <div class="col-lg-5 text-center" data-aos="zoom-in" data-aos-delay="100">
        <div class="profile-img-container">
          <img src="/images/profile.jpg" alt="<%= profile.full_name || 'Sakshi Bobade' %>" class="img-fluid rounded-circle profile-img shadow-lg" style="max-width: 320px; width: 100%;">
        </div>
      </div>

      <!-- Right Content -->
      <div class="col-lg-7" data-aos="fade-left" data-aos-delay="200">
        <h5 class="text-gradient fw-semibold mb-2">Hello, I'm</h5>
        <h1 class="display-3 fw-bold mb-3"><%= profile.full_name || 'Sakshi Bobade' %></h1>
        <h3 class="fs-2 mb-4 text-light"><%= profile.role_headline || 'Data Analyst' %></h3>
        <p class="lead text-white mb-4">"<%= profile.bio || 'Computer Science Graduate skilled in Data Analytics, SQL, Python, and Power BI.' %>"</p>

        <div class="d-flex flex-wrap gap-3 mb-4">
  <a href="/projects" class="btn btn-gradient btn-lg">View Projects <i class="bi bi-arrow-right ms-2"></i></a>
  <a href="/resume.pdf" class="btn btn-outline-light btn-lg" target="_blank" download><i class="bi bi-download me-2"></i> Download Resume</a>
</div>

        <div class="d-flex align-items-center gap-3 fs-3">
          <% if (profile.github_url) { %>
            <a href="<%= profile.github_url %>" target="_blank" class="text-light hover-opacity"><i class="bi bi-github"></i></a>
          <% } %>
          <% if (profile.linkedin_url) { %>
            <a href="<%= profile.linkedin_url %>" target="_blank" class="text-primary hover-opacity"><i class="bi bi-linkedin"></i></a>
          <% } %>
          <% if (profile.email) { %>
  <a href="https://mail.google.com/mail/?view=cm&fs=1&to=sakshibobade10@gmail.com" target="_blank" class="text-danger hover-opacity" style="cursor: pointer; text-decoration: none;">
  <i class="bi bi-envelope-fill"></i>
</a>
<% } %>
        </div>
      </div>

    </div>
  </div>
</section>

<%- include("partials/footer") %>