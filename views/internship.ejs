<%- include("partials/header", { title: "Internship" }) %>
<%- include("partials/navbar") %>

<div class="container py-5 my-5">

    <div class="text-center mb-5" data-aos="fade-down">
        <h1 class="fw-bold text-gradient display-5">Internship Experience</h1>
        <p class="text-white lead">My Professional Learning Journey</p>
    </div>

    <div class="row">

        <% if (internships.length > 0) { %>

            <% internships.forEach(internship => { %>

                <div class="col-lg-6 mb-4" data-aos="fade-up">

                    <div class="glass-card p-4 h-100">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div>
                                <h3 class="text-white fw-bold mb-1">
                                    <%= internship.role %>
                                </h3>

                                <h5 class="text-gradient">
                                    <%= internship.company %>
                                </h5>
                            </div>

                            <span class="badge bg-primary">
                                <%= internship.duration %>
                            </span>

                        </div>

                        <p class="text-light">
                            <%= internship.description %>
                        </p>

                        <% if(internship.certificate){ %>

                            <a href="<%= internship.certificate %>"
                               target="_blank"
                               class="btn btn-outline-primary mt-3">

                                View Certificate

                            </a>

                        <% } %>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <div class="col-12 text-center">

                <h4 class="text-white">
                    No Internship Added Yet
                </h4>

            </div>

        <% } %>

    </div>

</div>

<%- include("partials/footer") %>